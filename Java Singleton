class Singleton {

    // The single instance of Singleton
    private static Singleton instance = null;

    // String variable
    public String str;

    // Private constructor
    private Singleton() {
    }

    // Method to get the single instance
    public static Singleton getSingleInstance() {

        if (instance == null) {
            instance = new Singleton();
        }

        return instance;
    }
}
