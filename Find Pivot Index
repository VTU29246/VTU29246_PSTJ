class Solution {
    public int pivotIndex(int[] nums) {

        int total = 0;

        // Find the total sum of the array
        for (int num : nums) {
            total += num;
        }

        int leftSum = 0;

        // Check every index
        for (int i = 0; i < nums.length; i++) {

            // Remove current element from total.
            // Now total represents the right side.
            total -= nums[i];

            // Check if left sum == right sum
            if (leftSum == total) {
                return i;
            }

            // Add current element to left sum
            leftSum += nums[i];
        }

        return -1;
    }
}
