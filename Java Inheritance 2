class Bird {

    void walk() {
        System.out.println("I am walking");
    }

    void fly() {
        System.out.println("I am flying");
    }
}

class Parrot extends Bird {

    void sing() {
        System.out.println("I am singing");
    }
}

public class Solution {

    public static void main(String args[]) {

        Parrot parrot = new Parrot();

        parrot.walk();
        parrot.fly();
        parrot.sing();
    }
}
