import java.util.*;

class Student {
}

class Rockstar {
}

class Hacker {
}

public class InstanceOFTutorial {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        Object[] objects = new Object[n];

        for (int i = 0; i < n; i++) {

            String type = sc.next();

            if (type.equals("Student")) {
                objects[i] = new Student();

            } else if (type.equals("Rockstar")) {
                objects[i] = new Rockstar();

            } else if (type.equals("Hacker")) {
                objects[i] = new Hacker();
            }
        }

        int studentCount = 0;
        int rockstarCount = 0;
        int hackerCount = 0;

        for (Object obj : objects) {

            if (obj instanceof Student) {
                studentCount++;
            }

            if (obj instanceof Rockstar) {
                rockstarCount++;
            }

            if (obj instanceof Hacker) {
                hackerCount++;
            }
        }

        System.out.println(
            studentCount + " " +
            rockstarCount + " " +
            hackerCount
        );

        sc.close();
    }
}
