import java.io.*;
import java.util.*;

public class Solution {

    /*
     * Manacher's algorithm on transformed string.
     *
     * Example:
     * "aba" -> "#a#b#a#"
     *
     * radius[i] tells us how far the palindrome centered at i extends.
     */
    static int[] manacher(String s) {

        int n = s.length();

        // Transformed string:
        // # a # b # a #
        char[] t = new char[2 * n + 1];

        for (int i = 0; i < t.length; i++) {
            if (i % 2 == 0) {
                t[i] = '#';
            } else {
                t[i] = s.charAt(i / 2);
            }
        }

        int[] radius = new int[t.length];

        int center = 0;
        int right = 0;

        for (int i = 0; i < t.length; i++) {

            int mirror = 2 * center - i;

            if (i < right) {
                radius[i] = Math.min(right - i, radius[mirror]);
            }

            while (i + radius[i] + 1 < t.length &&
                   i - radius[i] - 1 >= 0 &&
                   t[i + radius[i] + 1] ==
                   t[i - radius[i] - 1]) {

                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }

        return radius;
    }

    /*
     * Sparse Table for range maximum query.
     */
    static class SparseTable {

        int[][] table;
        int[] log;

        SparseTable(int[] arr) {

            int n = arr.length;

            log = new int[n + 1];

            for (int i = 2; i <= n; i++) {
                log[i] = log[i / 2] + 1;
            }

            int levels = log[n] + 1;

            table = new int[levels][n];

            System.arraycopy(arr, 0, table[0], 0, n);

            for (int k = 1; k < levels; k++) {

                int len = 1 << k;
                int half = len >> 1;

                for (int i = 0; i + len <= n; i++) {

                    table[k][i] = Math.max(
                        table[k - 1][i],
                        table[k - 1][i + half]
                    );
                }
            }
        }

        int query(int left, int right) {

            if (left > right) {
                return 0;
            }

            int len = right - left + 1;
            int k = log[len];

            return Math.max(
                table[k][left],
                table[k][right - (1 << k) + 1]
            );
        }
    }

    /*
     * Check whether a palindrome of at least length len
     * exists inside the current rotation.
     */
    static boolean possible(
            SparseTable rmq,
            int start,
            int n,
            int len) {

        /*
         * We use the transformed string.
         *
         * A palindrome of length len needs a center whose
         * radius is at least len.
         */
        int left = 2 * start + len - 1;
        int right = 2 * (start + n - 1) - len + 1;

        if (left > right) {
            return false;
        }

        return rmq.query(left, right) >= len;
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());

        String s = br.readLine().trim();

        /*
         * Duplicate the string.
         *
         * Example:
         * abcde
         *
         * becomes:
         * abcdeabcde
         *
         * Every rotation is now a substring of length n.
         */
        String doubled = s + s;

        int[] radius = manacher(doubled);

        SparseTable rmq = new SparseTable(radius);

        StringBuilder output = new StringBuilder();

        /*
         * Rotation starting at position start:
         *
         * start = 0 -> original string
         * start = 1 -> rotate left by 1
         * start = 2 -> rotate left by 2
         * ...
         */
        for (int start = 0; start < n; start++) {

            int low = 1;
            int high = n;
            int answer = 1;

            /*
             * Binary search the longest palindrome length.
             */
            while (low <= high) {

                int mid = low + (high - low) / 2;

                if (possible(rmq, start, n, mid)) {

                    answer = mid;
                    low = mid + 1;

                } else {
                    high = mid - 1;
                }
            }

            output.append(answer).append('\n');
        }

        System.out.print(output);
    }
}
